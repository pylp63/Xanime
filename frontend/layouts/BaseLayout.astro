---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>X动漫 — 在线动漫播放平台</title>
  <meta name="description" content="X动漫 — 高画质动漫视频在线播放，极速加载" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    // Apply saved theme (or system preference) before first paint — no flash.
    (function () {
      var t = null;
      try { t = localStorage.getItem('xanime-theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body class="text-text font-sans antialiased">
  <slot />
  <script src="/spa-client.js" defer></script>
</body>
</html>
