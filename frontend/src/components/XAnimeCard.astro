---
import { getCoverUrl } from '../types';

interface Props {
  xanime: {
    id: number;
    title: string;
    cover: string;
    category: string;
    episodes: number;
    year: number;
    rating: number;
  };
}

const { xanime } = Astro.props;
---

<a
  href={`/xanime/${xanime.id}/`}
  class="xanime-card block group"
>
  <div class="relative aspect-[3/4] overflow-hidden">
    <img
      src={getCoverUrl(xanime.cover)}
      alt={xanime.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    {xanime.rating > 0 && (
      <div class="glass-chip-accent absolute top-2 right-2 text-xs font-bold px-2 py-1 rounded-lg">
        ★ {xanime.rating.toFixed(1)}
      </div>
    )}
    <div class="glass-chip absolute bottom-2 left-2 text-xs px-2 py-1 rounded-lg">
      {xanime.episodes} 话
    </div>
  </div>

  <div class="p-3">
    <h3 class="font-semibold text-sm leading-tight line-clamp-1">{xanime.title}</h3>
    <div class="flex items-center gap-2 mt-1.5">
      <span class="text-xs text-text-muted">{xanime.year}</span>
      <span class="w-1 h-1 bg-text-muted rounded-full" />
      <span class="text-xs px-1.5 py-0.5 rounded-lg bg-white/5 text-primary-light border border-white/10">
        {xanime.category}
      </span>
    </div>
  </div>
</a>
