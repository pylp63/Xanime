---
import BaseLayout from '../layouts/BaseLayout.astro';

const search = Astro.url.searchParams.get('search') || '';
const category = Astro.url.searchParams.get('category') || '';
---

<BaseLayout>
  <div class="min-h-screen">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-nav">
      <div class="max-w-[1600px] mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="logo-mark">X</span>
          <span class="text-xl brand-text">X动漫</span>
        </a>
        <form action="/" method="GET" class="flex-1 max-w-md mx-6">
          <div class="relative">
            <input
              type="text" name="search" placeholder="搜索X动漫…" value={search}
              class="glass-input !py-2 text-sm"
            />
            <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
          </div>
        </form>
        <div id="nav-auth" class="flex items-center gap-3">
          <a href="/login/" class="btn-liquid text-sm">登录</a>
        </div>
      </div>
    </nav>

    <div class="max-w-[1600px] mx-auto px-4 flex gap-6 items-start">
      <!-- 左侧分类菜单 -->
      <aside class="sticky top-20 w-52 shrink-0 hidden md:block py-8">
        <div class="glass rounded-3xl p-3">
          <div class="px-3 pt-2 pb-3 text-xs font-semibold text-text-muted tracking-wider">分类</div>
          <nav id="sidebar-cats" class="space-y-1">
            <div class="px-3 py-2 text-sm text-text-muted">加载中…</div>
          </nav>
        </div>
      </aside>

      <!-- 内容区 -->
      <div id="app" class="flex-1 min-w-0">
        <main class="py-8 animate-fade-in">
          {!search && !category && (
            <div class="mb-8 text-center md:text-left">
              <h1 class="text-3xl md:text-4xl font-bold mb-3">探索新世界 • <span class="brand-text">X动漫</span></h1>
            </div>
          )}
          {(search || category) && (
            <div class="mb-6 flex items-center gap-2 flex-wrap">
              {category && <h2 class="text-lg">分类：<span class="brand-text">{category}</span></h2>}
              {search && <h2 class="text-lg">搜索：<span class="brand-text">"{search}"</span></h2>}
              <span class="text-text-muted text-sm" id="result-count"></span>
            </div>
          )}
          <div id="grid" class="stagger-in grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            <div class="col-span-full text-center py-20 text-text-muted text-lg">加载中…</div>
          </div>
        </main>
      </div>
    </div>

    <div class="pb-10"></div>
  </div>
</BaseLayout>

<script>
  (function () {
    const grid = document.getElementById('grid');
    const catsNav = document.getElementById('sidebar-cats');
    let userRole = 'user';
    const rolePromise = fetch('/api/me', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (me) { if (me && me.role) userRole = me.role; })
      .catch(function () {});
    const countEl = document.getElementById('result-count');
    const q = new URLSearchParams(window.location.search);
    const activeCategory = q.get('category') || '';
    const search = q.get('search') || '';

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function catHref(cat) {
      const p = new URLSearchParams();
      if (cat) p.set('category', cat);
      if (search) p.set('search', search);
      const qs = p.toString();
      return qs ? '/?' + qs : '/';
    }

    function renderSidebar(categories) {
      if (!catsNav) return;
      const items = [{ key: '', label: '全部' }].concat(
        categories.map(function (c) { return { key: c, label: c }; })
      );
      catsNav.innerHTML = items.map(function (it) {
        const active = it.key === activeCategory;
        const cls = active ? 'episode-btn active' : 'episode-btn';
        return '<a href="' + catHref(it.key) + '" class="' + cls + ' block w-full text-left px-3 py-2 text-sm font-medium truncate">' +
          (it.key === '' ? '✦ ' : '') + esc(it.label) + '</a>';
      }).join('');
    }

    async function load() {
      await rolePromise;
      const params = new URLSearchParams();
      if (search) params.set('search', search);
      if (activeCategory) params.set('category', activeCategory);

      let res;
      try {
        res = await fetch('/api/library?' + params, { credentials: 'same-origin' });
      } catch (e) {
        grid.innerHTML = '<div class="col-span-full text-center py-20 text-text-muted text-lg">无法连接服务器</div>';
        return;
      }

      if (res.status === 401) {
        window.location.href = '/login';
        return;
      }
      if (!res.ok) {
        grid.innerHTML = '<div class="col-span-full text-center py-20 text-text-muted text-lg">加载失败，请刷新重试</div>';
        return;
      }

      const data = await res.json();
      renderSidebar(data.categories || []);
      const list = data.data || [];
      if (countEl) countEl.textContent = '(' + (data.total || list.length) + ' 部)';

      if (list.length === 0) {
        var emptyHtml = '<div class="col-span-full glass rounded-3xl text-center py-16 px-6">' +
          '<p class="text-text-muted text-lg">该分类暂无内容</p>';
        if (userRole === 'admin') {
          emptyHtml += '<p class="text-text-muted text-sm mt-2">在存储源目录下创建分类文件夹放入动漫即可，例如 <code>/data/Xanime/科幻/进击的巨人/第01话.mp4</code></p>' +
            '<a href="/settings/" class="btn-glass text-sm inline-block mt-4">管理存储源</a>';
        } else {
          emptyHtml += '<p class="text-text-muted text-sm mt-2">请联系管理员添加资源</p>';
        }
        emptyHtml += '</div>';
        grid.innerHTML = emptyHtml;
        return;
      }

      grid.innerHTML = list.map(function (a) {
        const href = '/xanime/' + encodeURIComponent(a.source_id) + '/' + encodeURIComponent(a.name) + '/';
        const cover = a.cover || ('https://via.placeholder.com/480x640/dbeafe/0a6fd8?text=' + encodeURIComponent((a.title || a.name).slice(0, 6)));
        return '<a href="' + href + '" class="xanime-card block group">' +
          '<div class="relative aspect-[3/4] overflow-hidden">' +
            '<img src="' + esc(cover) + '" alt="' + esc(a.title) + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />' +
            '<div class="glass-chip absolute bottom-2 left-2 text-xs px-2 py-1 rounded-lg">' + a.episodes + ' 集</div>' +
          '</div>' +
          '<div class="p-3">' +
            '<h3 class="font-semibold text-sm leading-tight line-clamp-2">' + esc(a.title || a.name) + '</h3>' +
            '<div class="flex items-center gap-2 mt-1.5">' +
              (a.year ? '<span class="text-xs text-text-muted">' + a.year + '</span><span class="w-1 h-1 bg-text-muted rounded-full"></span>' : '') +
              (a.category ? '<span class="tag-chip truncate max-w-[110px]">' + esc(a.category) + '</span>' : '') +
              (userRole === 'admin' ? '<span class="text-xs text-text-muted truncate max-w-[90px] ml-auto">' + esc(a.source_name) + '</span>' : '') +
            '</div>' +
          '</div>' +
        '</a>';
      }).join('');
    }

    load();
  })();
</script>
