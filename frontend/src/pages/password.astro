---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="min-h-[70vh] flex items-center justify-center animate-fade-in">
    <div class="glass rounded-3xl p-8 w-full max-w-sm">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold mb-1">修改密码</h1>
        <p class="text-text-muted text-sm">为自己的账号设置新密码</p>
      </div>

      <form id="pwdForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">原密码</label>
          <input id="old-password" type="password" required class="glass-input" autocomplete="current-password" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">新密码</label>
          <input id="new-password" type="password" required minlength="6" class="glass-input" autocomplete="new-password" placeholder="至少 6 位" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">确认新密码</label>
          <input id="new-password2" type="password" required minlength="6" class="glass-input" autocomplete="new-password" />
        </div>
        <div id="msg" class="hidden text-sm px-4 py-2.5 rounded-xl"></div>
        <button type="submit" class="btn-liquid w-full">
          <span class="relative z-10">保存新密码</span>
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('pwdForm');
  const msg = document.getElementById('msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const oldPw = (document.getElementById('old-password') as HTMLInputElement).value;
    const newPw = (document.getElementById('new-password') as HTMLInputElement).value;
    const newPw2 = (document.getElementById('new-password2') as HTMLInputElement).value;

    if (newPw !== newPw2) {
      msg!.textContent = '两次输入的新密码不一致';
      msg!.className = 'text-sm px-4 py-2.5 rounded-xl text-rose-600 bg-rose-500/10 border border-rose-400/30';
      return;
    }

    try {
      const res = await fetch('/api/auth/password', {
        method: 'PUT',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ old_password: oldPw, new_password: newPw }),
      });
      if (res.status === 401) { window.location.href = '/login'; return; }
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        msg!.textContent = '密码已更新，正在跳转到登录页…';
        msg!.className = 'text-sm px-4 py-2.5 rounded-xl text-emerald-600 bg-emerald-500/10 border border-emerald-400/40';
        (form as HTMLFormElement).reset();
        // 密码已变, 当前会话失效 — 2 秒后引导到登录页重新登录
        setTimeout(() => {
          localStorage.removeItem('token');
          localStorage.removeItem('role');
          window.location.href = '/login/';
        }, 2000);
      } else {
        msg!.textContent = data.error || '修改失败';
        msg!.className = 'text-sm px-4 py-2.5 rounded-xl text-rose-600 bg-rose-500/10 border border-rose-400/30';
      }
    } catch {
      msg!.textContent = '网络错误';
      msg!.className = 'text-sm px-4 py-2.5 rounded-xl text-rose-600 bg-rose-500/10 border border-rose-400/30';
    }
  });
</script>
