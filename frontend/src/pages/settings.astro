---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="min-h-screen">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-nav">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="logo-mark">X</span>
          <span class="text-xl brand-text">X动漫</span>
        </a>
        <div id="nav-auth" class="flex items-center gap-3">
          <a href="/login/" class="btn-liquid text-sm">登录</a>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-8 animate-fade-in">
      <h1 class="text-2xl font-bold mb-6">系统设置</h1>

      <div class="flex gap-6 items-start">
        <!-- 左侧设置菜单 -->
        <aside class="w-52 shrink-0 sticky top-20">
          <nav id="settings-menu" class="glass rounded-3xl p-3 space-y-1">
            <button data-tab="sources" class="tab-btn episode-btn active w-full text-left px-3 py-2.5 text-sm font-medium">
              💾 存储源
            </button>
            <button data-tab="add" class="tab-btn episode-btn w-full text-left px-3 py-2.5 text-sm font-medium">
              ➕ 添加存储源
            </button>
            <button data-tab="users" class="tab-btn episode-btn w-full text-left px-3 py-2.5 text-sm font-medium">
              👥 用户管理
            </button>
            <button data-tab="cats" class="tab-btn episode-btn w-full text-left px-3 py-2.5 text-sm font-medium">
              🏷️ 分类管理
            </button>
          </nav>
        </aside>

        <!-- 右侧内容区 -->
        <div class="flex-1 min-w-0">

          <!-- ── Tab: 存储源列表 ─────────────────────────────── -->
          <section id="tab-sources" class="tab-panel">
            <div class="glass rounded-3xl p-6">
              <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                已配置的存储源
                <span id="src-count" class="text-xs text-text-muted font-normal"></span>
              </h2>
              <div id="src-list" class="space-y-3">
                <div class="text-text-muted text-sm py-6 text-center">加载中…</div>
              </div>
            </div>
          </section>

          <!-- ── Tab: 添加存储源 ─────────────────────────────── -->
          <section id="tab-add" class="tab-panel hidden">
            <div class="glass rounded-3xl p-6">
              <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                添加存储源
              </h2>

              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium mb-1.5">名称 <span class="text-text-muted font-normal">(可选，用于展示)</span></label>
                  <input id="src-name" type="text" placeholder="例如：媒体库NFS / 华为OBS" class="glass-input" />
                </div>

                <div>
                  <label class="block text-sm font-medium mb-1.5">类型</label>
                                    <div id="type-cards" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                      <button type="button" data-type="local" class="type-card glass rounded-2xl p-3 text-left transition-all" data-selected="true">
                                        <div class="text-2xl mb-1">💾</div>
                                        <div class="text-sm font-semibold">本地磁盘</div>
                                        <div class="text-xs text-text-muted mt-0.5">服务器本地目录</div>
                                      </button>
                                      <button type="button" data-type="nfs" class="type-card glass rounded-2xl p-3 text-left transition-all" data-selected="false">
                                        <div class="text-2xl mb-1">🖧</div>
                                        <div class="text-sm font-semibold">NFS</div>
                                        <div class="text-xs text-text-muted mt-0.5">网络存储 · NFS</div>
                                      </button>
                                      <button type="button" data-type="nas" class="type-card glass rounded-2xl p-3 text-left transition-all" data-selected="false">
                                        <div class="text-2xl mb-1">🗄️</div>
                                        <div class="text-sm font-semibold">NAS</div>
                                        <div class="text-xs text-text-muted mt-0.5">网络存储 · NAS</div>
                                      </button>
                                      <button type="button" data-type="s3" class="type-card glass rounded-2xl p-3 text-left transition-all" data-selected="false">
                                        <div class="text-2xl mb-1">☁️</div>
                                        <div class="text-sm font-semibold">S3 对象存储</div>
                                        <div class="text-xs text-text-muted mt-0.5">MinIO / OBS / AWS</div>
                                      </button>
                                    </div>
                </div>

                <!-- Filesystem fields -->
                <div id="fs-fields" class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium mb-1.5">视频目录路径</label>
                    <input id="video-path" type="text" placeholder="/data/Xanime/localmedia 或 /data/Xanime/NFS" class="glass-input" />
                    <div class="text-xs text-text-muted mt-1.5 leading-relaxed">
                      <p>填写 <code class="text-[color:var(--accent)]">/data/Xanime</code> 下的子目录，前端只显示子目录名。</p>
                      <p class="mt-1">本地磁盘填 <code class="text-[color:var(--accent)]">/data/Xanime/localmedia</code>；NFS 填 <code class="text-[color:var(--accent)]">/data/Xanime/NFS</code>（宿主机已挂载到 /mnt/nfs 再 ln -s 软链进来）；NAS 同理。</p>
                    </div>
                  </div>
                </div>

                <!-- S3 fields -->
                <div id="s3-fields" class="space-y-4 hidden">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-sm font-medium mb-1.5">Endpoint</label>
                      <input id="s3-endpoint" type="text" placeholder="https://obs.cn-south-1.myhuaweicloud.com" class="glass-input" />
                    </div>
                    <div>
                      <label class="block text-sm font-medium mb-1.5">Bucket</label>
                      <input id="s3-bucket" type="text" placeholder="my-bucket" class="glass-input" />
                    </div>
                    <div>
                      <label class="block text-sm font-medium mb-1.5">Region</label>
                      <input id="s3-region" type="text" placeholder="cn-south-1" class="glass-input" />
                    </div>
                    <div>
                      <label class="block text-sm font-medium mb-1.5">Access Key</label>
                      <input id="s3-access-key" type="text" class="glass-input" />
                    </div>
                    <div class="md:col-span-2">
                      <label class="block text-sm font-medium mb-1.5">Secret Key</label>
                      <input id="s3-secret-key" type="password" placeholder="必填" class="glass-input" />
                    </div>
                  </div>
                </div>

                <div id="msg" class="hidden text-sm px-4 py-2.5 rounded-xl"></div>

                <button id="add-btn" class="btn-liquid w-full">
                  <span class="relative z-10">添加存储源</span>
                </button>
              </div>
            </div>
          </section>

          <!-- ── Tab: 用户管理 ───────────────────────────────── -->
          <section id="tab-users" class="tab-panel hidden">
            <div class="glass rounded-3xl p-6">
              <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                用户管理
                <span class="text-xs text-text-muted font-normal">重置普通用户密码</span>
              </h2>
              <div id="user-list" class="space-y-3">
                <div class="text-text-muted text-sm py-4 text-center">加载中…</div>
              </div>
            </div>
          </section>

          <!-- ── Tab: 分类管理 ───────────────────────────────── -->
          <section id="tab-cats" class="tab-panel hidden">
            <div class="glass rounded-3xl p-6">
              <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                分类管理
                <span class="text-xs text-text-muted font-normal">首页左侧菜单的分类，逐条增删</span>
              </h2>

              <!-- 新增分类 -->
              <div class="flex gap-2 mb-4">
                <input id="cat-new" type="text" class="glass-input flex-1" placeholder="输入新分类名称，如：悬疑" maxlength="20" />
                <button id="cat-add-btn" class="btn-liquid text-sm shrink-0"><span class="relative z-10">添加</span></button>
              </div>

              <!-- 分类列表 (拖拽排序) -->
              <div id="cat-list" class="space-y-2">
                <div class="text-text-muted text-sm py-6 text-center">加载中…</div>
              </div>

              <div id="cats-msg" class="hidden text-sm px-4 py-2.5 rounded-xl mt-3"></div>
            </div>
          </section>

        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  (function () {
    // ── 权限: 普通用户无权访问设置页 ──────────────────────────
    fetch('/api/me', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (me) {
      if (!me) return;
      if (me.role !== 'admin') {
        window.location.href = '/password/';
        return;
      }
      loadUsers();
      loadCats();
    });

    var listEl = document.getElementById('src-list');
    var countEl = document.getElementById('src-count');
    var nameEl = document.getElementById('src-name');
    var videoPathEl = document.getElementById('video-path');
    var s3Fields = document.getElementById('s3-fields');
    var fsFields = document.getElementById('fs-fields');
    var s3Endpoint = document.getElementById('s3-endpoint');
    var s3Bucket = document.getElementById('s3-bucket');
    var s3Region = document.getElementById('s3-region');
    var s3AccessKey = document.getElementById('s3-access-key');
    var s3SecretKey = document.getElementById('s3-secret-key');
    var msg = document.getElementById('msg');
    var addBtn = document.getElementById('add-btn');
    var currentType = 'local';

    // ── Tab 切换 ─────────────────────────────────────────────
    document.querySelectorAll('.tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.add('hidden'); });
        document.getElementById('tab-' + tab).classList.remove('hidden');
      });
    });

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    // 液态玻璃确认弹窗 (替代原生 confirm)
    function glassConfirm(message, opts) {
      return new Promise(function (resolve) {
        var overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:200;background:rgba(10,20,40,0.30);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .22s ease';
        overlay.innerHTML =
          '<div class="glass rounded-3xl p-6 w-full max-w-sm mx-4" style="transform:scale(.94);transition:transform .25s cubic-bezier(.22,1,.36,1)">' +
            '<h3 class="text-base font-bold mb-2">请确认</h3>' +
            '<p class="text-sm text-text-muted mb-5 leading-relaxed">' + message + '</p>' +
            '<div class="flex gap-2 justify-end">' +
              '<button class="btn-glass text-sm gc-cancel">取消</button>' +
              '<button class="' + ((opts && opts.danger) ? 'btn-danger' : 'btn-liquid') + ' text-sm gc-ok">' + ((opts && opts.okText) || '确定') + '</button>' +
            '</div>' +
          '</div>';
        document.body.appendChild(overlay);
        requestAnimationFrame(function () {
          overlay.style.opacity = '1';
          overlay.querySelector('.glass').style.transform = 'scale(1)';
        });
        function close(val) {
          overlay.style.opacity = '0';
          overlay.querySelector('.glass').style.transform = 'scale(.94)';
          setTimeout(function () { overlay.remove(); }, 220);
          resolve(val);
        }
        overlay.querySelector('.gc-ok').addEventListener('click', function () { close(true); });
        overlay.querySelector('.gc-cancel').addEventListener('click', function () { close(false); });
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(false); });
        document.addEventListener('keydown', function esc(e) {
          if (e.key === 'Escape') { document.removeEventListener('keydown', esc); close(false); }
        });
      });
    }

    // 液态玻璃输入弹窗 (替代原生 prompt)
    function glassPrompt(title, placeholder) {
      return new Promise(function (resolve) {
        var overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:200;background:rgba(10,20,40,0.30);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .22s ease';
        overlay.innerHTML =
          '<div class="glass rounded-3xl p-6 w-full max-w-sm mx-4" style="transform:scale(.94);transition:transform .25s cubic-bezier(.22,1,.36,1)">' +
            '<h3 class="text-base font-bold mb-4">' + title + '</h3>' +
            '<input type="text" class="glass-input gp-input" placeholder="' + (placeholder || '') + '" />' +
            '<div class="flex gap-2 justify-end mt-5">' +
              '<button class="btn-glass text-sm gp-cancel">取消</button>' +
              '<button class="btn-liquid text-sm gp-ok">确定</button>' +
            '</div>' +
          '</div>';
        document.body.appendChild(overlay);
        var input = overlay.querySelector('.gp-input');
        requestAnimationFrame(function () {
          overlay.style.opacity = '1';
          overlay.querySelector('.glass').style.transform = 'scale(1)';
          input.focus();
        });
        function close(val) {
          overlay.style.opacity = '0';
          overlay.querySelector('.glass').style.transform = 'scale(.94)';
          setTimeout(function () { overlay.remove(); }, 220);
          resolve(val);
        }
        overlay.querySelector('.gp-ok').addEventListener('click', function () { close(input.value.trim()); });
        overlay.querySelector('.gp-cancel').addEventListener('click', function () { close(null); });
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(null); });
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') close(input.value.trim());
          if (e.key === 'Escape') close(null);
        });
      });
    }

    function toast(text, ok) {
      var t = document.createElement('div');
      t.className = 'toast ' + (ok ? 'ok' : 'err');
      t.textContent = text;
      document.body.appendChild(t);
      setTimeout(function () { t.remove(); }, 3200);
    }

    function showMsg(text, ok) {
      msg.textContent = text;
      msg.className = ok
        ? 'text-sm px-4 py-2.5 rounded-xl text-emerald-600 bg-emerald-500/10 border border-emerald-400/40'
        : 'text-sm px-4 py-2.5 rounded-xl text-rose-600 bg-rose-500/10 border border-rose-400/30';
    }

    function typeLabel(type) {
      return { local: '本地磁盘', nfs: '网络存储 NFS', nas: '网络存储 NAS', s3: 'S3 对象存储' }[type] || type;
    }

    function selectType(type) {
      currentType = type;
      document.querySelectorAll('.type-card').forEach(function (card) {
        card.setAttribute('data-selected', card.getAttribute('data-type') === type ? 'true' : 'false');
      });
      s3Fields.classList.toggle('hidden', type !== 's3');
      fsFields.classList.toggle('hidden', type === 's3');
    }
    document.querySelectorAll('.type-card').forEach(function (card) {
      card.addEventListener('click', function () { selectType(card.getAttribute('data-type')); });
    });

    function srcRow(s) {
      var detail = '';
      if (s.type === 's3') {
        detail = esc((s.s3_endpoint || '').replace(/^https?:\/\//, '')) + ' / ' + esc(s.s3_bucket || '');
        if (!s.s3_secret_set) detail += ' <span class="text-rose-600">(缺少 Secret Key)</span>';
      } else {
        detail = esc(s.video_path || '');
      }
      return '<div class="glass rounded-2xl p-4 flex items-center justify-between gap-4" data-id="' + esc(s.id) + '">' +
        '<div class="min-w-0 flex items-center gap-3">' +
          '<span class="src-badge ' + esc(s.type) + '">' + typeLabel(s.type) + '</span>' +
          '<div class="min-w-0">' +
            '<div class="text-sm font-semibold truncate">' + esc(s.name) + '</div>' +
            '<div class="text-xs text-text-muted truncate font-mono">' + detail + '</div>' +
          '</div>' +
        '</div>' +
        '<button class="btn-danger del-btn text-sm shrink-0" data-id="' + esc(s.id) + '" data-name="' + esc(s.name) + '">删除</button>' +
      '</div>';
    }

    function bindDelete() {
      document.querySelectorAll('.del-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var okDel = await glassConfirm('确定删除存储源「' + btn.getAttribute('data-name') + '」？<br><span class="text-xs">已绑定该源的剧集将无法播放。</span>', { danger: true, okText: '删除' });
          if (!okDel) return;
          btn.disabled = true;
          try {
            var res = await fetch('/api/admin/storage-srcs/' + encodeURIComponent(btn.getAttribute('data-id')), {
              method: 'DELETE', credentials: 'same-origin'
            });
            if (res.status === 401) { window.location.href = '/login'; return; }
            var body = await res.json().catch(function () { return {}; });
            if (res.ok) { toast('存储源已删除', true); await load(); }
            else toast(body.error || '删除失败', false);
          } catch (e) {
            toast('网络错误', false);
          }
        });
      });
    }

    async function load() {
      var res;
      try {
        res = await fetch('/api/storage-srcs', { credentials: 'same-origin' });
      } catch (e) {
        listEl.innerHTML = '<div class="text-rose-600 text-sm py-6 text-center">无法连接服务器</div>';
        return;
      }
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) { listEl.innerHTML = '<div class="text-rose-600 text-sm py-6 text-center">加载失败</div>'; return; }
      var data = await res.json();
      var sources = data.sources || [];
      countEl.textContent = '(' + sources.length + ')';
      if (sources.length === 0) {
        listEl.innerHTML = '<div class="text-text-muted text-sm py-6 text-center">暂无存储源，请在「添加存储源」中添加</div>';
        return;
      }
      listEl.innerHTML = sources.map(srcRow).join('');
      bindDelete();
    }

    addBtn.addEventListener('click', async function () {
      msg.classList.add('hidden');
      var body = { name: nameEl.value.trim(), type: currentType };
      if (currentType === 's3') {
        body.s3_endpoint = s3Endpoint.value.trim();
        body.s3_bucket = s3Bucket.value.trim();
        body.s3_region = s3Region.value.trim() || 'us-east-1';
        body.s3_access_key = s3AccessKey.value.trim();
        body.s3_secret_key = s3SecretKey.value;
        if (!body.s3_endpoint || !body.s3_bucket || !body.s3_access_key || !body.s3_secret_key) {
          showMsg('S3 存储需要填写 Endpoint、Bucket、Access Key 和 Secret Key', false);
          return;
        }
      } else {
        body.video_path = videoPathEl.value.trim();
        if (!body.video_path) {
          showMsg('请填写视频目录路径', false);
          return;
        }
      }

      addBtn.disabled = true;
      try {
        var res = await fetch('/api/admin/storage-srcs', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.status === 401) { window.location.href = '/login'; return; }
        var resp = await res.json().catch(function () { return {}; });
        if (res.ok) {
          toast('存储源「' + (body.name || typeLabel(body.type)) + '」已添加', true);
          nameEl.value = ''; videoPathEl.value = '';
          s3Endpoint.value = ''; s3Bucket.value = ''; s3Region.value = '';
          s3AccessKey.value = ''; s3SecretKey.value = '';
          // 跳回存储源列表 tab
          document.querySelector('.tab-btn[data-tab="sources"]').click();
          await load();
        } else {
          showMsg(resp.error || '添加失败', false);
        }
      } catch (e) {
        showMsg('网络错误', false);
      } finally {
        addBtn.disabled = false;
      }
    });

    // ── 用户管理 ──────────────────────────────────────────────
    async function loadUsers() {
      var el = document.getElementById('user-list');
      try {
        var res = await fetch('/api/admin/users', { credentials: 'same-origin' });
        if (!res.ok) { el.innerHTML = '<div class="text-rose-600 text-sm py-4 text-center">加载失败</div>'; return; }
        var data = await res.json();
        el.innerHTML = (data.users || []).map(function (u) {
          return '<div class="glass rounded-2xl p-4 flex items-center justify-between gap-4">' +
            '<div class="flex items-center gap-3 min-w-0">' +
              '<span class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background:rgba(10,132,255,.12);color:#0a6fd8;">' + esc(u.username.charAt(0).toUpperCase()) + '</span>' +
              '<span class="text-sm font-semibold truncate">' + esc(u.username) + '</span>' +
              (u.role === 'admin' ? '<span class="tag-chip">管理员</span>' : '') +
            '</div>' +
            (u.role === 'admin' ? '' :
              '<div class="flex gap-2 shrink-0">' +
                '<button class="btn-glass text-sm reset-btn" data-user="' + esc(u.username) + '">重置密码</button>' +
                '<button class="btn-danger text-sm del-user-btn" data-user="' + esc(u.username) + '">删除</button>' +
              '</div>') +
          '</div>';
        }).join('');
        el.querySelectorAll('.reset-btn').forEach(function (btn) {
          btn.addEventListener('click', async function () {
            var user = btn.getAttribute('data-user');
            var np = await glassPrompt('为用户「' + user + '」设置新密码', '至少 6 位');
            if (np === null) return;
            if (np.length < 6) { toast('密码至少 6 位', false); return; }
            try {
              var res = await fetch('/api/admin/users/' + encodeURIComponent(user) + '/password', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ new_password: np })
              });
              if (res.ok) toast('已重置 ' + user + ' 的密码', true);
              else { var e = await res.json().catch(function(){return{}}); toast(e.error || '重置失败', false); }
            } catch (e) { toast('网络错误', false); }
          });
        });
        el.querySelectorAll('.del-user-btn').forEach(function (btn) {
          btn.addEventListener('click', async function () {
            var user = btn.getAttribute('data-user');
            var okU = await glassConfirm('确定删除用户「' + user + '」？<br><span class="text-xs">该账号将无法登录。</span>', { danger: true, okText: '删除' });
            if (!okU) return;
            btn.disabled = true;
            try {
              var res = await fetch('/api/admin/users/' + encodeURIComponent(user), {
                method: 'DELETE', credentials: 'same-origin'
              });
              if (res.ok) { toast('已删除用户 ' + user, true); await loadUsers(); }
              else { var e = await res.json().catch(function(){return{}}); toast(e.error || '删除失败', false); btn.disabled = false; }
            } catch (e) { toast('网络错误', false); btn.disabled = false; }
          });
        });
      } catch (e) {
        el.innerHTML = '<div class="text-rose-600 text-sm py-4 text-center">加载失败</div>';
      }
    }

    // ── 分类管理: 逐条增删 + 拖拽排序, 每次操作即时保存 ────────
    var cats = [];           // 当前分类数组 (顺序即菜单顺序)
    var catListEl = document.getElementById('cat-list');
    var catNewEl = document.getElementById('cat-new');
    var catMsgEl = document.getElementById('cats-msg');

    async function saveCats() {
      try {
        var res = await fetch('/api/admin/categories', {
          method: 'PUT', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ categories: cats })
        });
        if (res.ok) return true;
        var e = await res.json().catch(function () { return {}; });
        toast(e.error || '保存失败', false);
        return false;
      } catch (e) { toast('网络错误', false); return false; }
    }

    function renderCats() {
      if (cats.length === 0) {
        catListEl.innerHTML = '<div class="text-text-muted text-sm py-6 text-center">暂无分类，请在上方添加</div>';
        return;
      }
      catListEl.innerHTML = cats.map(function (cat, i) {
        return '<div class="glass rounded-2xl px-3 py-2.5 flex items-center gap-2 cat-row" draggable="true" data-idx="' + i + '">' +
          '<span class="cursor-grab text-text-muted select-none" title="拖拽排序">⋮⋮</span>' +
          '<span class="text-sm font-medium flex-1 truncate cat-label">' + esc(cat) + '</span>' +
          (i > 0 ? '<button class="btn-glass !px-2 !py-1 text-xs cat-up" data-idx="' + i + '" title="上移">↑</button>' : '') +
          (i < cats.length - 1 ? '<button class="btn-glass !px-2 !py-1 text-xs cat-down" data-idx="' + i + '" title="下移">↓</button>' : '') +
          '<button class="btn-danger !px-2.5 !py-1 text-xs cat-del" data-idx="' + i + '">删除</button>' +
        '</div>';
      }).join('');
      bindCatEvents();
    }

    function bindCatEvents() {
      // 删除
      catListEl.querySelectorAll('.cat-del').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var name = cats[idx];
          var okDel = await glassConfirm('删除分类「' + name + '」？', { danger: true, okText: '删除' });
          if (!okDel) return;
          cats.splice(idx, 1);
          if (await saveCats()) { toast('已删除「' + name + '」', true); renderCats(); }
        });
      });
      // 上移/下移 — 带 FLIP 换位动画, 让变化看得见
      catListEl.querySelectorAll('.cat-up, .cat-down').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var dir = btn.classList.contains('cat-up') ? -1 : 1;
          var j = idx + dir;
          if (j < 0 || j >= cats.length) return;
          var tmp = cats[idx]; cats[idx] = cats[j]; cats[j] = tmp;
          if (!(await saveCats())) return;
          // FLIP: 记录旧行位置 → 重渲染 → 新位置反向位移 → 过渡回 0
          var before = new Map();
          catListEl.querySelectorAll('.cat-row').forEach(function (row) {
            before.set(row.querySelector('.cat-label').textContent, row.getBoundingClientRect().top);
          });
          renderCats();
          catListEl.querySelectorAll('.cat-row').forEach(function (row) {
            var label = row.querySelector('.cat-label').textContent;
            var oldTop = before.get(label);
            if (oldTop === undefined) return;
            var delta = oldTop - row.getBoundingClientRect().top;
            if (Math.abs(delta) < 1) return;
            row.animate(
              [
                { transform: 'translateY(' + delta + 'px)' },
                { transform: 'translateY(0)' }
              ],
              { duration: 300, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
            );
          });
        });
      });
      // 拖拽排序
      var dragIdx = -1;
      catListEl.querySelectorAll('.cat-row').forEach(function (row) {
        row.addEventListener('dragstart', function () { dragIdx = parseInt(row.getAttribute('data-idx'), 10); });
        row.addEventListener('dragover', function (e) { e.preventDefault(); });
        row.addEventListener('drop', async function (e) {
          e.preventDefault();
          var toIdx = parseInt(row.getAttribute('data-idx'), 10);
          if (dragIdx < 0 || dragIdx === toIdx) return;
          var moved = cats.splice(dragIdx, 1)[0];
          cats.splice(toIdx, 0, moved);
          dragIdx = -1;
          if (await saveCats()) { renderCats(); toast('顺序已更新', true); }
        });
      });
    }

    // 添加分类 (回车或按钮)
    async function addCat() {
      var name = catNewEl.value.trim();
      catMsgEl.classList.add('hidden');
      if (!name) return;
      if (cats.indexOf(name) !== -1) {
        catMsgEl.textContent = '分类「' + name + '」已存在';
        catMsgEl.className = 'text-sm px-4 py-2.5 rounded-xl text-rose-600 bg-rose-500/10 border border-rose-400/30';
        return;
      }
      cats.push(name);
      if (await saveCats()) {
        catNewEl.value = '';
        toast('已添加「' + name + '」', true);
        renderCats();
      } else {
        cats.pop();
      }
    }
    document.getElementById('cat-add-btn').addEventListener('click', addCat);
    catNewEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); addCat(); }
    });

    async function loadCats() {
      try {
        var res = await fetch('/api/categories', { credentials: 'same-origin' });
        if (!res.ok) return;
        var data = await res.json();
        cats = data.categories || [];
        renderCats();
      } catch (e) {}
    }

    selectType('local');
    load();
  })();
</script>
